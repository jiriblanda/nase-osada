rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isRoomMember() {
      return signedIn()
        && resource.data.players is list
        && resource.data.players.size() >= 1
        && resource.data.players.size() <= 6
        && (
          (resource.data.players.size() > 0 && resource.data.players[0].uid == request.auth.uid)
          || (resource.data.players.size() > 1 && resource.data.players[1].uid == request.auth.uid)
          || (resource.data.players.size() > 2 && resource.data.players[2].uid == request.auth.uid)
          || (resource.data.players.size() > 3 && resource.data.players[3].uid == request.auth.uid)
          || (resource.data.players.size() > 4 && resource.data.players[4].uid == request.auth.uid)
          || (resource.data.players.size() > 5 && resource.data.players[5].uid == request.auth.uid)
        );
    }

    function isNotAlreadyMember(players) {
      return (players.size() < 1 || players[0].uid != request.auth.uid)
        && (players.size() < 2 || players[1].uid != request.auth.uid)
        && (players.size() < 3 || players[2].uid != request.auth.uid)
        && (players.size() < 4 || players[3].uid != request.auth.uid)
        && (players.size() < 5 || players[4].uid != request.auth.uid)
        && (players.size() < 6 || players[5].uid != request.auth.uid);
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(["code", "hostUid", "players", "status", "round", "actionsPerPlayer", "createdAt"])
        && request.resource.data.code == roomId
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.players is list
        && request.resource.data.players.size() == 1
        && request.resource.data.players[0].uid == request.auth.uid
        && request.resource.data.players[0].name is string
        && request.resource.data.status == "waiting"
        && request.resource.data.round == 1
        && request.resource.data.actionsPerPlayer == 2;

      allow get: if signedIn()
        && (isRoomMember()
          || (resource.data.status == "waiting"
            && resource.data.players is list
            && resource.data.players.size() >= 1
            && resource.data.players.size() < 6));

      allow list: if false;

      allow update: if signedIn()
        && resource.data.status == "waiting"
        && resource.data.players is list
        && resource.data.players.size() >= 1
        && resource.data.players.size() < 6
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["players"])
        && request.resource.data.players is list
        && request.resource.data.players.size() == resource.data.players.size() + 1
        && request.resource.data.players.hasAll(resource.data.players)
        && request.resource.data.players[resource.data.players.size()].uid == request.auth.uid
        && request.resource.data.players[resource.data.players.size()].name is string
        && isNotAlreadyMember(resource.data.players);

      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }
  }
}