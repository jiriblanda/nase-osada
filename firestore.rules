rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isRoomMember() {
      return signedIn()
        && (request.auth.uid == resource.data.hostUid
          || request.auth.uid == resource.data.guestUid);
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.code == roomId
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.guestUid == null
        && request.resource.data.status == "waiting"
        && request.resource.data.players.size() == 1
        && request.resource.data.players[0].uid == request.auth.uid
        && request.resource.data.players[0].name is string
        && request.resource.data.round == 1
        && request.resource.data.actionsPerPlayer == 2;

      allow get: if signedIn()
        && (resource.data.status == "waiting" || isRoomMember());

      allow list: if false;

      allow update: if signedIn()
        && resource.data.status == "waiting"
        && resource.data.players.size() == 1
        && resource.data.guestUid == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["guestUid", "players", "status"])
        && request.resource.data.guestUid == request.auth.uid
        && request.resource.data.status == "ready"
        && request.resource.data.players.size() == 2
        && request.resource.data.players[0].uid == resource.data.players[0].uid
        && request.resource.data.players[1].uid == request.auth.uid
        && request.resource.data.players[1].name is string;

      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }
  }
}